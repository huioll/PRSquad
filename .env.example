# 复制为 .env 后按需修改。所有项都有默认值，不填也能启动（演示模式）。

# ── 模型 ─────────────────────────────────────────────
# stub = 假模型，不联网、不花钱，用于跑测试和演示界面
# openai = 真实模型（走 OpenAI 协议，兼容 DeepSeek / 通义 / Moonshot）
PRSQUAD_LLM_PROVIDER=stub

# 只有 llm_provider=openai 时才需要下面三项
PRSQUAD_OPENAI_API_KEY=
# 留空则打 OpenAI 官方端点。国内模型填各自的兼容端点：
#   DeepSeek  https://api.deepseek.com/v1
#   通义千问  https://dashscope.aliyuncs.com/compatible-mode/v1
#   Moonshot  https://api.moonshot.cn/v1
PRSQUAD_OPENAI_BASE_URL=
PRSQUAD_OPENAI_MODEL=deepseek-chat

# ── GitHub（可选，只在要往 PR 里发评论时才需要）────────
PRSQUAD_GITHUB_TOKEN=
# 默认 false：本地调试不会往别人仓库刷评论
PRSQUAD_POST_COMMENTS=false
# 留空则跳过 webhook 签名校验，方便本地用 curl 测试
PRSQUAD_WEBHOOK_SECRET=

# ── 服务 ─────────────────────────────────────────────
PRSQUAD_PORT=8001
